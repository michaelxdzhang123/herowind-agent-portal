<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HeroAI-Gateway - Login</title>
    <link rel="stylesheet" href="/static/css/login.css">
</head>
<body class="signin">
    <div class="signinpanel">
        <div class="logopanel">
            <h1>HeroGateway</h1>
        </div>
        <form action="/login" method="post">
            {% if error %}
            <div style="background: rgba(200, 0, 0, 0.4); padding: 10px; margin-bottom: 15px; border-radius: 3px; color: #fff; font-size: 14px;">
                {{ error }}
            </div>
            {% endif %}
            <input type="text" name="username" class="form-control uname" placeholder="Username" required autofocus>
            <input type="password" name="password" class="form-control pword" placeholder="Password" required>
            <button type="submit" class="btn" style="width: 100%; padding: 10px; background: #1caf9a; color: #fff; border: none; border-radius: 3px; cursor: pointer; font-size: 14px;">Login</button>
        </form>
    </div>
</body>
</html>
